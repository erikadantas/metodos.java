public class Telefone {
   private String numero;
public Telefone(String numero) {
this.numero = numero;
}

public String  getNumero() {
    return numero;
}

@Override
public String toString() {
    return numero;
}
}

public class Gerente {
    private String nome;
    public Gerente(String nome) {
    this.nome = nome
}
public String getNome() {
    return nome;
}

@Override
public String toString() {
    return "Gerente: " + nome;
}
}

public class Filial {
    private String nome;
    private Gerente gerente;
    private List<Telefone> telefones;

    public Filial(String nome, Gerente gerente, List<Telefone> telefones) {
        this.nome = nome;
        this.gerente = gerente;
        this.telefones = telefones;
    }

    public String getNome() {
        return nome;
    }

    public Gerente getGerente() {
        return gerente;
    }

    public List<Telefone> getTelefones() {
        return telefones;
    }

    @Override
    public String toString() {
        return "Filial: " + nome + "\n" +
               gerente + "\n" +
               "Telefones: " + telefones;
    }
}

public class Main {
public Static void Main(String[] args) {

  Telefone telefone = new Telefone(numero: "1234");

  telefone.exibirInformacoes();

  telefone.setNumero(1234);

  telefone.exibirInformacoes();
}
}
