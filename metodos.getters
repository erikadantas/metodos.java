public class Telefone {
   private String numero;
public Telefone(String numero) {
this.numero = numero;
}

public String  getNumero() {
    return numero;
}

@Override
public String toString() {
    return numero;
}
}

public class Gerente {
    private String nome;
    public Gerente(String nome) {
    this.nome = nome
}
public String getNome() {
    return nome;
}

@Override
public String toString() {
    return "Gerente: " + nome;
}
}

